<Window x:Class="Wpf.ApplicationForms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="CoreFusion"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F6F8">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Özel Başlık Çubuğu -->

        <Border Grid.Row="0"
                Background="#1F2937"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CoreFusion"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0" />

                <dx:SimpleButton Grid.Column="1"
                                 Content="─"
                                 Width="50"
                                 Height="40"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="18"
                                 Click="MinimizeButton_Click" />

            </Grid>

        </Border>

        <!-- Uygulama Alanı -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol Menü -->

            <Border Grid.Column="0"
                    Background="#1F2937">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="10,20">

                        <dx:SimpleButton Content="Ana Sayfa"
                                         Style="{StaticResource MenuButtonStyle}" />

                        <dx:SimpleButton Content="Firmalar"
                                         Style="{StaticResource MenuButtonStyle}"
                                         Click="CompaniesButton_Click" />

                        <dx:SimpleButton Content="Ürünler"
                                         Style="{StaticResource MenuButtonStyle}" />

                        <dx:SimpleButton Content="Cari"
                                         Style="{StaticResource MenuButtonStyle}" />

                        <dx:SimpleButton Content="Muhasebe"
                                         Style="{StaticResource MenuButtonStyle}" />

                    </StackPanel>

                        <dx:SimpleButton Grid.Row="1"
                                        Content="Çıkış"
                                        Height="40"
                                        Margin="10,5"
                                        Glyph="{dx:DXImage Image=Close_16x16.png}"
                                        GlyphHeight="16"
                                        GlyphWidth="16"
                                        GlyphAlignment="Left"
                                        CornerRadius="4"
                                        Click="ExitButton_Click" />

                </Grid>

            </Border>

            <!-- İçerik -->

            <Grid Grid.Column="1"
                  Background="#F5F6F8">

                <ContentControl x:Name="ContentArea" />

            </Grid>

        </Grid>

    </Grid>

</Window>