<Window x:Class="Wpf.ApplicationForms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="CoreFusion"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5F6F8"
        Loaded="MainWindow_Loaded">

    <Window.Resources>

        <Style x:Key="CascadingMenuItemStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Height"
                    Value="34" />

            <Setter Property="Margin"
                    Value="0,1,0,1" />

            <Setter Property="Padding"
                    Value="12,0" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="CornerRadius"
                    Value="4" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#374151" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="CascadingMenuTextStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="#F9FAFB" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <Style x:Key="CascadingMenuArrowStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="#9CA3AF" />

            <Setter Property="FontSize"
                    Value="14" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

            <Setter Property="HorizontalAlignment"
                    Value="Right" />

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık Çubuğu -->

        <Border Grid.Row="0"
                Background="#1F2937"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CoreFusion"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0" />

                <dx:SimpleButton Grid.Column="1"
                                 Content="─"
                                 Width="50"
                                 Height="40"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="18"
                                 Click="MinimizeButton_Click" />

                <dx:SimpleButton Grid.Column="2"
                                 Content="✕"
                                 Width="50"
                                 Height="40"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="White"
                                 FontSize="16"
                                 Click="ExitButton_Click" />

            </Grid>

        </Border>

        <!-- Ortak Çalışma Alanı -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Firma"
                               Foreground="#4B5563"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <dxe:ComboBoxEdit x:Name="CompanyComboBoxEdit"
                                      Width="280"
                                      Height="36"
                                      NullText="Firma seçiniz..."
                                      IsTextEditable="False"
                                      IncrementalFiltering="True"
                                      DisplayMember="Name"
                                      EditValueChanged="CompanyComboBoxEdit_EditValueChanged" />

                </StackPanel>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center">

                    <TextBlock Text="Dönem"
                               Foreground="#4B5563"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <dxe:ComboBoxEdit x:Name="PeriodComboBoxEdit"
                                      Width="280"
                                      Height="36"
                                      NullText="Dönem seçiniz..."
                                      IsTextEditable="False"
                                      IncrementalFiltering="True"
                                      DisplayMember="DisplayText"
                                      EditValueChanged="PeriodComboBoxEdit_EditValueChanged" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- Ana Uygulama Alanı -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol Menü -->

            <Border Grid.Column="0"
                    Background="#1F2937">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="MainMenuPanel"
                                    Margin="10,12" />

                    </ScrollViewer>

                    <!-- Çıkış -->

                    <dx:SimpleButton Grid.Row="1"
                                     Content="Çıkış"
                                     Height="40"
                                     Margin="10,5"
                                     Glyph="{dx:DXImage Image=Close_16x16.png}"
                                     GlyphHeight="16"
                                     GlyphWidth="16"
                                     GlyphAlignment="Left"
                                     CornerRadius="4"
                                     Click="ExitButton_Click" />

                </Grid>

            </Border>

            <!-- İçerik -->

            <Grid Grid.Column="1"
                  Background="#F3F0F7">

                <ContentControl x:Name="ContentArea" />

                <!-- Ana Sayfa -->

                <Grid x:Name="HomeContent"
                      Background="#F3F0F7"
                      Visibility="Collapsed">

                    <Border Margin="40"
                            Background="#FAF7FC"
                            CornerRadius="8"
                            BorderBrush="#E5D9EA"
                            BorderThickness="1">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="CoreFusion"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="Hoş Geldiniz"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Margin="0,10,0,20"
                                       HorizontalAlignment="Center" />

                            <TextBlock x:Name="HomeContextText"
                                       Text="Lütfen firma ve dönem seçiniz."
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#9B1C5A"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="700"
                                       HorizontalAlignment="Center" />

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>