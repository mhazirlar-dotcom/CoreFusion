<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">

    <Style TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="Background"
                Value="White" />
    </Style>

    <Style x:Key="PhoneTextEditStyle"
       TargetType="{x:Type dxe:TextEdit}">

        <Setter Property="Background"
            Value="White" />

        <Setter Property="MaskType"
            Value="Simple" />

        <Setter Property="Mask"
            Value="\0(000) 000 00 00" />

        <Setter Property="MaskUseAsDisplayFormat"
            Value="True" />

    </Style>

    <Style TargetType="{x:Type dxe:ComboBoxEdit}">
        <Setter Property="Background"
                Value="White" />
    </Style>

    <Style TargetType="{x:Type dxe:DateEdit}">
        <Setter Property="Background"
                Value="White" />
    </Style>

    <Style TargetType="{x:Type dxe:SpinEdit}">
        <Setter Property="Background"
                Value="White" />
    </Style>

</ResourceDictionary>