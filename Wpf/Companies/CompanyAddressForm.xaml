<Window x:Class="Wpf.Companies.CompanyAddressForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:local="clr-namespace:Wpf.Core.Behaviors"
        xmlns:behavior="clr-namespace:Wpf.Core.Behaviors"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        
        
        
        
        Title="Adres Tanımı"
        Width="650"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxlc:LayoutControl Grid.Row="0">

            <dxlc:LayoutGroup Orientation="Vertical">

                <dxlc:LayoutGroup Header="Adres Bilgileri"
                                  Orientation="Vertical">

                    <dxlc:LayoutItem Label="Adres Tipi">

                        <dxe:ComboBoxEdit x:Name="AddressTypeComboBox"
                                          DisplayMember="Name"
                                          IncrementalFiltering="True"
                                          FilterCondition="Contains"
                                          ValidateOnTextInput="False"
                                          AutoComplete="False"
                                          ImmediatePopup="True" />

                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="İl">

                        <dxe:ComboBoxEdit x:Name="CityComboBox"
                                          DisplayMember="Name"
                                          IncrementalFiltering="True"
                                          FilterCondition="Contains"
                                          ValidateOnTextInput="False"
                                          AutoComplete="False"
                                          ImmediatePopup="True"
                                          EditValueChanged="CityComboBox_EditValueChanged" />

                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="İlçe">

                        <dxe:ComboBoxEdit x:Name="DistrictComboBox"
                                          DisplayMember="Name"
                                          IncrementalFiltering="True"
                                          FilterCondition="Contains"
                                          ValidateOnTextInput="False"
                                          AutoComplete="False"
                                          ImmediatePopup="True" />

                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Adres">

                        <dxe:TextEdit x:Name="AddressTextEdit"
                                      local:ProperCaseBehavior.IsEnabled="True" />

                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Posta Kodu">

                        <dxe:TextEdit x:Name="PostalCodeTextEdit" />

                    </dxlc:LayoutItem>

                    <dxlc:LayoutItem Label="Varsayılan">

                        <dxe:CheckEdit x:Name="DefaultCheckEdit"
                                       Content="Varsayılan adres olarak kullan" />

                    </dxlc:LayoutItem>

                </dxlc:LayoutGroup>

            </dxlc:LayoutGroup>

        </dxlc:LayoutControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <dx:SimpleButton Content="İptal"
                    Glyph="{dx:DXImage Image=Close_16x16.png}"
                    GlyphHeight="16"
                    GlyphWidth="16"
                    Style="{StaticResource GridActionButtonStyle}"
                    Click="CancelButton_Click" />

            <dx:SimpleButton Content="Tamam"
                    Glyph="{dx:DXImage Image=Save_16x16.png}"
                    GlyphHeight="16"
                    GlyphWidth="16"
                    Style="{StaticResource GridActionButtonStyle}"
                    Click="OkButton_Click"/>

        </StackPanel>

    </Grid>

</Window>