<UserControl x:Class="Wpf.Companies.CompanyListForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxg:GridControl x:Name="CompaniesGridControl"
                         Grid.Row="0">

            <dxg:GridControl.View>
                <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                               ShowAutoFilterRow="False"
                               ShowCriteriaInAutoFilterRow="False" />
            </dxg:GridControl.View>

            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Name"
                                Header="Firma Adı"
                                Width="300"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="ShortName"
                                Header="Kısa Ad"
                                Width="150"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="TaxOfficeName"
                                Header="Vergi Dairesi"
                                Width="200"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="TaxNumber"
                                Header="Vergi No"
                                Width="140"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="TcIdentityNumber"
                                Header="TC Kimlik No"
                                Width="140"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="EstablishmentDate"
                                Header="Kuruluş Tarihi"
                                Width="130"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="ClosingDate"
                                Header="Kapanış Tarihi"
                                Width="130"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="IsActive"
                                Header="Aktif"
                                Width="80"
                                HorizontalHeaderContentAlignment="Center" />
            </dxg:GridControl.Columns>

        </dxg:GridControl>

        <Grid Grid.Row="1"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <dx:SimpleButton Content="Dönemler"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Calendar.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="PeriodsButton_Click" />

                <dx:SimpleButton Content="Ortaklar"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Group.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="PartnersButton_Click" />

                <dx:SimpleButton Content="Adresler"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Home.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="AddressesButton_Click" />

                <dx:SimpleButton Content="İletişim"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Contact.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="ContactsButton_Click" />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <dx:SimpleButton Content="Yeni"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Add.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="NewButton_Click" />

                <dx:SimpleButton Content="Düzenle"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Edit.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Click="EditButton_Click" />

                <dx:SimpleButton Content="Sil"
                                 Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Delete.svg'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16"
                                 Style="{StaticResource GridActionButtonStyle}"
                                 Margin="0"
                                 Click="DeleteButton_Click" />

            </StackPanel>

        </Grid>

    </Grid>
</UserControl>