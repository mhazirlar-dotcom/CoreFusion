<UserControl x:Class="Wpf.Companies.CompanyListForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <dxg:GridControl x:Name="CompaniesGridControl"
                         Grid.Row="0">

            <dxg:GridControl.View>
                <dxg:TableView Style="{StaticResource ReadOnlyTableViewStyle}"
                               ShowAutoFilterRow="False" ShowCriteriaInAutoFilterRow="False" />
            </dxg:GridControl.View>

            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Name"
                                Header="Firma Adı"
                                Width="400"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="ShortName"
                                Header="Kısa Ad"
                                Width="150"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="TaxNumber"
                                Header="Vergi No"
                                Width="140"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="TradeRegistryNumber"
                                Header="Ticaret Sicil No"
                                Width="150"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="MersisNumber"
                                Header="MERSİS No"
                                Width="150"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="Website"
                                Header="Web Sitesi"
                                Width="200"
                                HorizontalHeaderContentAlignment="Center" />

                <dxg:GridColumn FieldName="IsActive"
                                Header="Aktif"
                                Width="80"
                                HorizontalHeaderContentAlignment="Center" />

            </dxg:GridControl.Columns>

        </dxg:GridControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">

            <dx:SimpleButton Content="Yeni"
                             Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Add.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16"
                             Style="{StaticResource GridActionButtonStyle}"
                             Click="NewButton_Click" />

            <dx:SimpleButton Content="Düzenle"
                             Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Edit.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16"
                             Style="{StaticResource GridActionButtonStyle}"
                             Click="EditButton_Click" />

            <dx:SimpleButton Content="Dönemler"
                             Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Refresh.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16"
                             Style="{StaticResource GridActionButtonStyle}"
                             Click="PeriodsButton_Click" />

            <dx:SimpleButton Content="Sil"
                             Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Delete.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16"
                             Style="{StaticResource GridActionButtonStyle}"
                             Click="DeleteButton_Click" />

            <dx:SimpleButton Content="Yenile"
                             Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Refresh.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16"
                             Style="{StaticResource GridActionButtonStyle}"
                             Margin="0"
                             Click="RefreshButton_Click" />

        </StackPanel>

    </Grid>
</UserControl>